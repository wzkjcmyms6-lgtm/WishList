// Reglas de Firestore de Ositos.
//
// Cómo se pegan: consola de Firebase → Firestore Database → pestaña "Reglas" →
// borrar todo lo que haya → pegar esto → "Publicar".
//
// La identidad es el CORREO, no el UID. El UID cambia cada vez que se vuelve a
// crear una cuenta (por ejemplo si se pierde la contraseña) y eso dejaría las
// entradas viejas huérfanas y estas reglas desactualizadas. El correo no cambia.
// Por eso los documentos guardan 'autor' con el perfil ('lentina' / 'manolo')
// en vez del UID.
//
// Que estos correos estén a la vista no abre nada: sin la contraseña de la
// cuenta no se puede iniciar sesión, y los dos ya están registrados, así que
// nadie más puede crearlos.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function correoLentina()   { return 'lentina@ositos.local'; }
    function correoManuelito() { return 'manuelito@ositos.local'; }

    function correo() {
      return request.auth != null ? request.auth.token.email : '';
    }

    // Solo nosotros dos, y con sesión iniciada.
    function somosNosotros() {
      return correo() in [correoLentina(), correoManuelito()];
    }

    // 'lentina' o 'manolo': es lo que guardan los documentos.
    function miPerfil() {
      return correo() == correoLentina() ? 'lentina' : 'manolo';
    }

    function soyElAutor()    { return resource.data.autor == miPerfil(); }
    function loCreoComoMio() { return request.resource.data.autor == miPerfil(); }

    // true si la edición toca únicamente los campos de la lista.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- Diario ----------

    // Los borradores viven aparte y no en 'entries' con una marca: si
    // estuvieran mezclados, cualquier consulta a la línea de tiempo traería
    // también los del otro y Firestore rechazaría la consulta entera.
    match /drafts/{draftId} {
      allow read:   if somosNosotros() && soyElAutor();
      allow create: if somosNosotros() && loCreoComoMio();
      allow update: if somosNosotros() && soyElAutor() && loCreoComoMio();
      allow delete: if somosNosotros() && soyElAutor();
    }

    match /entries/{entryId} {
      allow read:   if somosNosotros();
      allow create: if somosNosotros() && loCreoComoMio();
      // El otro solo puede tocar las reacciones; el resto, solo el autor.
      allow update: if somosNosotros() && (soyElAutor() || soloCambia(['reactions']));
      allow delete: if somosNosotros() && soyElAutor();

      match /comments/{commentId} {
        allow read:           if somosNosotros();
        allow create:         if somosNosotros() && loCreoComoMio();
        allow update, delete: if somosNosotros() && soyElAutor();
      }
    }

    // Miniatura + datos de cada foto.
    match /photos/{photoId} {
      allow read:           if somosNosotros();
      allow create:         if somosNosotros() && loCreoComoMio();
      allow update, delete: if somosNosotros() && soyElAutor();
    }

    // Foto en tamaño grande, en documento aparte para no descargarla de más.
    match /photo_files/{photoId} {
      allow read:           if somosNosotros();
      allow create:         if somosNosotros() && loCreoComoMio();
      allow update, delete: if somosNosotros() && soyElAutor();
    }

    // ---------- Pregunta del día ----------
    // Un documento por persona y día, con id "AAAA-MM-DD_perfil".
    // La respuesta del otro recién se puede leer cuando ya existe la tuya: esto
    // lo impone el servidor, no la pantalla.

    match /answers/{answerId} {
      allow read: if somosNosotros() && (
        soyElAutor()
        || exists(/databases/$(database)/documents/answers/$(resource.data.date + '_' + miPerfil()))
      );
      allow create: if somosNosotros()
        && loCreoComoMio()
        && answerId == request.resource.data.date + '_' + miPerfil();
      allow update: if somosNosotros() && soyElAutor();
      allow delete: if false;
    }

    // ---------- Gracias del día ----------

    match /gratitude/{gratitudeId} {
      allow read: if somosNosotros();
      allow create: if somosNosotros()
        && loCreoComoMio()
        && gratitudeId == request.resource.data.date + '_' + miPerfil();
      allow update, delete: if somosNosotros() && soyElAutor();
    }

    // ---------- Ajustes compartidos ----------

    match /settings/{docId} {
      allow read, write: if somosNosotros();
    }

    // ---------- Deseos ----------

    match /wishlist_items/{itemId} {
      allow read:   if somosNosotros();
      allow create: if somosNosotros() && request.resource.data.owner == miPerfil();
      // El dueño edita lo suyo; el otro solo puede reservar o soltar la reserva.
      allow update: if somosNosotros() && (
        resource.data.owner == miPerfil()
        || soloCambia(['reserved', 'reservedBy'])
      );
      allow delete: if somosNosotros() && resource.data.owner == miPerfil();
    }

    match /food_items/{itemId} {
      allow read:           if somosNosotros();
      allow create:         if somosNosotros() && request.resource.data.owner == miPerfil();
      allow update, delete: if somosNosotros() && resource.data.owner == miPerfil();
    }

    // ---------- Gustos de Lentina ----------
    // Es la chuleta de regalos de Manuelito: Lentina no lo lee ni lo escribe.

    match /preferences/lentina {
      allow read, write: if correo() == correoManuelito();
    }

    // Todo lo que no esté nombrado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
